# Keep all these values on the server. Never use a NEXT_PUBLIC_ or VITE_ prefix.
# Accounts can be configured later; guest games work without a database.
# Use MongoDB Atlas or another MongoDB replica set.
MONGODB_URI=
MONGODB_DATABASE=farshore
BETTER_AUTH_URL=http://localhost:3000
# Generate a separate random secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Generate 32 random bytes encoded as base64; keep this stable for saved API keys.
FARSHORE_ENCRYPTION_KEY=

# Verification and password reset emails. Use your mail provider's SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# The AI rival. Every encounter needs a reachable OpenAI-compatible model.
# Local Ollama: `ollama pull qwen3:4b-instruct`. No strong laptop? Run
# colab/farshore_model_server.ipynb on Google Colab and paste the lines it prints.
# Used in development, never as a shared public credential.
# FARSHORE_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# FARSHORE_MODEL_NAME=qwen3:4b-instruct
FARSHORE_API_KEY=
# Optional: a smaller, faster model for live commentary than for strategy.
# FARSHORE_COMMENTARY_MODEL=
# Voices. By default the game server speaks with Kokoro-82M's natural voices,
# downloading the model (about 180 MB) into .cache/models on first use.
# FARSHORE_TTS=browser leaves speech to the browser's own voices instead.
# FARSHORE_TTS=
# FARSHORE_MODEL_CACHE=
# Or use any OpenAI-compatible /v1/audio/speech server, such as the one the
# Colab notebook starts:
# FARSHORE_TTS_URL=http://127.0.0.1:8880/v1/audio/speech
# FARSHORE_TTS_MODEL=kokoro
# FARSHORE_TTS_KEY=
