# Keep all these values on the server. Never use a NEXT_PUBLIC_ or VITE_ prefix.
# Accounts can be configured later; guest games work without a database.
# Use MongoDB Atlas or another MongoDB replica set.
MONGODB_URI=
MONGODB_DATABASE=farshore
BETTER_AUTH_URL=http://localhost:3000
# Generate a separate random secret of at least 32 characters.
BETTER_AUTH_SECRET=
# Generate 32 random bytes encoded as base64; keep this stable for saved API keys.
FARSHORE_ENCRYPTION_KEY=

# Verification and password reset emails. Use your mail provider's SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional local AI. Used in development, never as a shared public credential.
# FARSHORE_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# FARSHORE_MODEL_NAME=llama3.2:3b
FARSHORE_API_KEY=
