{
  "name": "farshore",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "tsc --noEmit && node scripts/run-framework.mjs build --webpack",
    "preview": "node scripts/run-framework.mjs start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev:offline": "vite --config vite.offline.config.ts",
    "build:offline": "tsc --noEmit && vite build --config vite.offline.config.ts",
    "start": "node scripts/run-framework.mjs start",
    "preview:offline": "vite preview --config vite.offline.config.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.7",
    "better-auth": "^1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "mongodb": "^7.7.0",
    "next": "16.3.4",
    "nodemailer": "^10.1.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
